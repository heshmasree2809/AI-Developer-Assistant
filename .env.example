# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT Secret for token signing and authentication
JWT_SECRET="super-secret-jwt-key-for-ai-developer-assistant"

# LLM Provider Configuration (gemini, openai, anthropic, or local)
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-3.7-flash"

# Database connection URL for PostgreSQL (e.g. postgresql://user:password@localhost:5432/aidev_db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aidev_db"

# Server Port
PORT=3000

